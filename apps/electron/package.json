{
  "name": "@forge/electron",
  "version": "0.26.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "Forge Desktop",
  "author": {
    "name": "a-mart"
  },
  "homepage": "https://github.com/a-mart/forge",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:all": "node ./scripts/build-all.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:secure-vault-async": "node ./scripts/secure-vault-async-smoke.mjs",
    "prepare:dev-native": "node ./scripts/prepare-dev-native.mjs",
    "verify:runtime": "node ./scripts/verify-electron-runtime.mjs",
    "dev": "pnpm verify:runtime && pnpm prepare:dev-native && node esbuild.config.mjs && node ./scripts/run-electron-dev.mjs",
    "start": "pnpm verify:runtime && pnpm prepare:dev-native && node ./scripts/run-electron-dev.mjs",
    "pack": "pnpm build:all && electron-builder --dir",
    "package": "pnpm build:all && electron-builder --publish never",
    "dist": "pnpm run package"
  },
  "dependencies": {
    "@forge/client-runtime": "workspace:*",
    "@forge/protocol": "workspace:*",
    "@napi-rs/keyring": "1.3.0",
    "electron-updater": "^6.8.3",
    "koffi": "2.15.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.9",
    "graceful-fs": "^4.2.11",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}

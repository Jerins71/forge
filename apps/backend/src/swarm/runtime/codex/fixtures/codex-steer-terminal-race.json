{
  "provider": "codex",
  "protocol": "app-server/stdio-jsonrpc",
  "version": "0.155.0",
  "scenario": "steer-terminal-race",
  "provenance": "Synthetic raw Codex app-server frames reproducing terminal projection lag before an explicit steer rejection. Only process transport is substituted.",
  "entries": [
    {
      "type": "expect_outbound",
      "frame": {
        "id": "$any",
        "method": "initialize",
        "params": {
          "capabilities": {
            "experimentalApi": true
          }
        }
      },
      "capture": {
        "$rpcId": [
          "id"
        ]
      }
    },
    {
      "type": "emit_inbound",
      "frame": {
        "id": "$rpcId",
        "result": {
          "userAgent": "codex-cli/0.155.0"
        }
      }
    },
    {
      "type": "expect_outbound",
      "frame": {
        "method": "initialized"
      }
    },
    {
      "type": "expect_outbound",
      "frame": {
        "id": "$any",
        "method": "account/login/start",
        "params": {
          "type": "apiKey",
          "apiKey": "forge-fixture-inert-not-a-provider-key"
        }
      },
      "capture": {
        "$rpcId": [
          "id"
        ]
      }
    },
    {
      "type": "emit_inbound",
      "frame": {
        "id": "$rpcId",
        "result": {
          "type": "apiKey"
        }
      }
    },
    {
      "type": "expect_outbound",
      "frame": {
        "id": "$any",
        "method": "thread/start",
        "params": {
          "model": "gpt-6-sol",
          "cwd": "$cwd",
          "developerInstructions": "Forge replay contract",
          "approvalPolicy": "never",
          "sandbox": "danger-full-access",
          "allowProviderModelFallback": false,
          "dynamicTools": "$any",
          "ephemeral": false
        }
      },
      "capture": {
        "$rpcId": [
          "id"
        ]
      },
      "label": "open"
    },
    {
      "type": "emit_inbound",
      "frame": {
        "id": "$rpcId",
        "result": {
          "thread": {
            "id": "native-root",
            "path": "$rollout"
          },
          "model": "gpt-6-sol"
        }
      }
    },
    {
      "type": "expect_outbound",
      "frame": {
        "id": "$any",
        "method": "turn/start",
        "params": {
          "threadId": "native-root",
          "input": [
            {
              "type": "text",
              "text": "Work"
            }
          ],
          "model": "gpt-6-sol"
        }
      },
      "capture": {
        "$rpcId": [
          "id"
        ]
      },
      "label": "start"
    },
    {
      "type": "emit_inbound",
      "frame": {
        "id": "$rpcId",
        "result": {
          "turn": {
            "id": "turn-root",
            "status": "inProgress",
            "items": []
          }
        }
      }
    },
    {
      "type": "emit_inbound",
      "frame": {
        "method": "turn/started",
        "params": {
          "threadId": "native-root",
          "turn": {
            "id": "turn-root"
          }
        }
      }
    },
    {
      "type": "expect_outbound",
      "frame": {
        "id": "$any",
        "method": "turn/steer",
        "params": {
          "threadId": "native-root",
          "expectedTurnId": "turn-root"
        }
      },
      "capture": {
        "$rpcId": [
          "id"
        ]
      },
      "label": "start"
    },
    {
      "type": "emit_inbound",
      "frame": {
        "method": "turn/completed",
        "params": {
          "threadId": "native-root",
          "turn": {
            "id": "turn-root",
            "status": "completed",
            "items": [],
            "error": null
          }
        }
      }
    },
    {
      "type": "emit_inbound",
      "frame": {
        "id": "$rpcId",
        "error": {
          "code": -32602,
          "message": "Turn is no longer active"
        }
      },
      "label": "rejected"
    }
  ]
}

{
  "provider": "claude",
  "protocol": "agent-sdk/stdio-control",
  "version": "0.3.280",
  "scenario": "fail-mid-stream",
  "provenance": "Synthetic raw frames from the installed SDK wire contract; not captured from a real account. The reply is still streaming text when the native reports the turn failed.",
  "entries": [
    {
      "type": "expect_outbound",
      "frame": {
        "type": "control_request",
        "request": {
          "subtype": "initialize",
          "sdkMcpServers": [
            "forge"
          ],
          "appendSystemPrompt": "$prompt"
        }
      },
      "capture": {
        "$initId": [
          "request_id"
        ]
      }
    },
    {
      "type": "emit_inbound",
      "frame": {
        "type": "control_response",
        "response": {
          "subtype": "success",
          "request_id": "$initId",
          "response": {
            "commands": [],
            "models": [],
            "agents": []
          }
        }
      }
    },
    {
      "type": "expect_outbound",
      "frame": {
        "type": "user",
        "uuid": "$any",
        "parent_tool_use_id": null,
        "message": {
          "role": "user",
          "content": [
            {
              "type": "text",
              "text": "work"
            }
          ]
        }
      },
      "capture": {
        "$inputId": [
          "uuid"
        ]
      },
      "label": "input"
    },
    {
      "type": "emit_inbound",
      "label": null,
      "frame": {
        "type": "stream_event",
        "session_id": "$sessionId",
        "parent_tool_use_id": null,
        "uuid": "stream-envelope-0",
        "event": {
          "type": "message_start",
          "message": {
            "id": "stream-message",
            "type": "message",
            "role": "assistant",
            "model": "claude-opus-5-5",
            "content": [],
            "stop_reason": null,
            "usage": {
              "input_tokens": 5,
              "output_tokens": 0
            }
          }
        },
        "user_message_uuid": "$inputId"
      }
    },
    {
      "type": "emit_inbound",
      "label": null,
      "frame": {
        "type": "stream_event",
        "session_id": "$sessionId",
        "parent_tool_use_id": null,
        "uuid": "stream-envelope-4",
        "event": {
          "type": "content_block_start",
          "index": 1,
          "content_block": {
            "type": "text",
            "text": ""
          }
        }
      }
    },
    {
      "type": "emit_inbound",
      "label": null,
      "frame": {
        "type": "stream_event",
        "session_id": "$sessionId",
        "parent_tool_use_id": null,
        "uuid": "stream-envelope-5",
        "event": {
          "type": "content_block_delta",
          "index": 1,
          "delta": {
            "type": "text_delta",
            "text": "Streaming answer"
          }
        }
      }
    },
    {
      "type": "emit_inbound",
      "frame": {
        "type": "result",
        "subtype": "error_during_execution",
        "is_error": true,
        "duration_ms": 3,
        "duration_api_ms": 2,
        "num_turns": 1,
        "total_cost_usd": 0.001,
        "usage": {
          "input_tokens": 11,
          "output_tokens": 2,
          "cache_read_input_tokens": 0,
          "cache_creation_input_tokens": 0
        },
        "modelUsage": {},
        "permission_denials": [],
        "uuid": "result-1",
        "session_id": "$sessionId",
        "errors": [
          "Synthetic provider failure"
        ]
      },
      "label": "failed"
    }
  ]
}

{
  "provider": "codex",
  "protocol": "app-server/stdio-jsonrpc",
  "version": "0.155.0",
  "scenario": "controlled-send",
  "provenance": "Synthetic redacted frames matching Forge's native Codex 0.155 boundary. Not captured from a real account; fixture fidelity needs a real-provider spot check.",
  "entries": [
    {
      "type": "expect_outbound",
      "frame": {
        "id": "$any",
        "method": "initialize",
        "params": {
          "capabilities": {
            "experimentalApi": true
          }
        }
      },
      "capture": {
        "$rpcId": [
          "id"
        ]
      }
    },
    {
      "type": "emit_inbound",
      "frame": {
        "id": "$rpcId",
        "result": {
          "userAgent": "codex-cli/0.155.0"
        }
      }
    },
    {
      "type": "expect_outbound",
      "frame": {
        "method": "initialized"
      }
    },
    {
      "type": "expect_outbound",
      "frame": {
        "id": "$any",
        "method": "account/login/start",
        "params": {
          "type": "apiKey",
          "apiKey": "forge-fixture-inert-not-a-provider-key"
        }
      },
      "capture": {
        "$rpcId": [
          "id"
        ]
      }
    },
    {
      "type": "emit_inbound",
      "frame": {
        "id": "$rpcId",
        "result": {
          "type": "apiKey"
        }
      }
    },
    {
      "type": "expect_outbound",
      "frame": {
        "id": "$any",
        "method": "thread/start",
        "params": {
          "cwd": "$cwd",
          "model": "gpt-6-sol",
          "approvalPolicy": "never",
          "sandbox": "danger-full-access",
          "ephemeral": false,
          "allowProviderModelFallback": false
        }
      },
      "capture": {
        "$rpcId": [
          "id"
        ]
      }
    },
    {
      "type": "emit_inbound",
      "frame": {
        "id": "$rpcId",
        "result": {
          "thread": {
            "id": "$threadId",
            "path": "$rollout"
          },
          "model": "gpt-6-sol"
        }
      }
    },
    {
      "type": "expect_outbound",
      "label": "provider-start",
      "frame": {
        "id": "$any",
        "method": "turn/start",
        "params": {
          "threadId": "$threadId",
          "model": "gpt-6-sol",
          "input": [
            {
              "type": "text",
              "text": "$any"
            }
          ]
        }
      },
      "capture": {
        "$rpcId": [
          "id"
        ]
      }
    },
    {
      "type": "emit_inbound",
      "label": "start-ack",
      "frame": {
        "id": "$rpcId",
        "result": {
          "turn": {
            "id": "replay-turn",
            "status": "inProgress",
            "items": []
          }
        }
      }
    },
    {
      "type": "emit_inbound",
      "label": "terminal",
      "frame": {
        "method": "turn/completed",
        "params": {
          "threadId": "$threadId",
          "turn": {
            "id": "replay-turn",
            "status": "completed",
            "items": [],
            "error": null
          }
        }
      }
    }
  ]
}

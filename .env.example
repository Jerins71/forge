# Core (legacy MIDDLEMAN_* names are still accepted)
# FORGE_HOST=127.0.0.1
# FORGE_PORT=47187
# FORGE_DATA_DIR=~/.forge
# FORGE_DEBUG=false          # Also enables extension tool-call logging
# FORGE_TELEMETRY=false      # Disable anonymous telemetry (enabled by default)
# FORGE_STREAM_DECK_SETUP_ENABLED=false  # Opt in to Stream Deck preparation for Electron dev/package builds

# Optional Expo push authentication. Use a private absolute-path token file;
# never put the token itself in .env. Restart Forge after changing this path/file.
# FORGE_EXPO_PUSH_ACCESS_TOKEN_FILE=/path/to/private/expo-push-token

# UI (legacy VITE_MIDDLEMAN_WS_URL and VITE_MIDDLEMAN_WS_PORT are still accepted)
# VITE_FORGE_WS_URL=ws://127.0.0.1:47187
# VITE_FORGE_WS_PORT=47187

# Skills
# BRAVE_API_KEY=
# EXA_API_KEY=
# GEMINI_API_KEY=

# Provider API-key fallbacks (Settings/shared secrets take precedence where applicable)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=
# CURSOR_API_KEY=

# Skill sharing (anonymous worker at https://forgeskills.radops.ai by default)
# FORGE_SKILL_SHARE_BASE_URL=https://forgeskills.radops.ai
# FORGE_SKILL_SHARE_DISABLED=false
# Legacy aliases still accepted:
# MIDDLEMAN_SKILL_SHARE_BASE_URL=https://forgeskills.radops.ai
# MIDDLEMAN_SKILL_SHARE_DISABLED=false

# Removed in Forge V2: FORGE_COLLABORATION_*, FORGE_REMOTE_PROJECTS_*, FORGE_ADMIN_*, and the
# collaboration-server runtime target. A FORGE_RUNTIME_TARGET other than builder, a truthy
# FORGE_REMOTE_PROJECTS_ENABLED, or a truthy FORGE_COLLABORATION_ENABLED without a runtime
# target aborts startup; unset them.

# Agent Runtimes
# OpenAI Codex Responses transport defaults to sse for reliability when unset, blank, or invalid.
# websocket-cached remains available as an explicit experimental/canary opt-in.
# Supported values: sse, websocket, websocket-cached, auto. Invalid values fail safe to sse.
# FORGE_OPENAI_CODEX_TRANSPORT=sse

# OpenAI/Codex auth source (v1 Forge Auth broker scope: OpenAI/Codex only)
# FORGE_OPENAI_CODEX_AUTH_MODE=local
# When FORGE_OPENAI_CODEX_AUTH_MODE=central_broker, Forge uses the Forge Auth broker for OpenAI/Codex.
# Env overrides are strict: saved Settings broker URL/token are ignored while the env mode is set.
# FORGE_OPENAI_AUTH_BROKER_URL=http://127.0.0.1:8787
# FORGE_OPENAI_AUTH_BROKER_TOKEN=<lease-scoped-bearer-token>
# FORGE_OPENAI_AUTH_BROKER_INSTANCE_ID=<stable-install-id>
# FORGE_OPENAI_AUTH_BROKER_INSTANCE_LABEL=<human-readable-install-label>
# Request timeout defaults to 10000 ms and is clamped to 1000-60000 ms.
# FORGE_OPENAI_AUTH_BROKER_TIMEOUT_MS=10000
# Optional: enable the sanitized /api/debug/codex-transport diagnostics endpoint.
# FORGE_CODEX_TRANSPORT_DEBUG=1

# Integrated terminal runtime (legacy MIDDLEMAN_TERMINAL_* aliases are also accepted)
# FORGE_TERMINAL_ENABLED=true
# FORGE_TERMINAL_MAX_PER_SESSION=10
# FORGE_TERMINAL_DEFAULT_COLS=120
# FORGE_TERMINAL_DEFAULT_ROWS=30
# FORGE_TERMINAL_SCROLLBACK_LINES=5000
# FORGE_TERMINAL_OUTPUT_BATCH_MS=16
# FORGE_TERMINAL_SNAPSHOT_INTERVAL_MS=30000
# FORGE_TERMINAL_JOURNAL_MAX_BYTES=1048576
# FORGE_TERMINAL_SHUTDOWN_SNAPSHOT_TIMEOUT_MS=8000
# FORGE_TERMINAL_RESTORE_STARTUP_CONCURRENCY=4
# FORGE_TERMINAL_WS_TICKET_TTL_MS=60000
# FORGE_TERMINAL_WS_MAX_BUFFERED_AMOUNT_BYTES=1048576
# Saved Settings default shell wins when both are present.
# FORGE_TERMINAL_DEFAULT_SHELL=/bin/zsh

# Electron signing / packaging examples
# macOS signing + notarization:
# APPLE_ID=developer@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=ABCDE12345
# Windows signing (optional):
# CSC_LINK=base64-or-file-path-to-pfx
# CSC_KEY_PASSWORD=your-certificate-password
# WIN_CSC_LINK=base64-or-file-path-to-pfx
# WIN_CSC_KEY_PASSWORD=your-certificate-password

# Secure Sessions executor: docker (default) or nono (macOS/Linux; install separately).
# FORGE_SECURE_EXECUTION_BACKEND=nono
# FORGE_NONO_PATH=/absolute/path/to/nono

# Native Claude managers use the local Claude subscription login by default.
# See docs/NATIVE_CLAUDE.md. Existing Forge Anthropic OAuth credentials are separate.
# FORGE_CLAUDE_AUTH_MODE=cli
# Opt into API billing explicitly with api_key and an Anthropic API key.
# FORGE_CLAUDE_AUTH_MODE=api_key
# CLAUDE_CONFIG_DIR=/absolute/path/to/claude-config
# Optional override; normally use Forge's bundled native executable.
# CLAUDE_BIN=/absolute/path/to/claude
